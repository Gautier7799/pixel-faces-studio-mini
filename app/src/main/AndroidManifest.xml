            Spacer(modifier = Modifier.height(24.dp))

            Button(
                onClick = {
                    coroutineScope.launch {
                        snackbarHostState.showSnackbar("✨ تم تطبيق وتصدير واجهة الساعة الفاخرة بنجاح!")
