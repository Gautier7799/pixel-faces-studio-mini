// -------------------------------------------------------------
// المعاينة ورسم الساعة عبر Canvas
// -------------------------------------------------------------

@Composable
fun AnalogWatchPreview(
    handsStyle: HandsStyle,
    dialBackground: DialBackground,
    indexStyle: DialIndexStyle,
    theme: MaterialYouThemeColor,
    showDate: Boolean,
    showBattery: Boolean,
    showWeather: Boolean,
    showHeartRate: Boolean,
    showSteps: Boolean,
    liveSeconds: Boolean
) {
    var currentTime by remember { mutableStateOf(Calendar.getInstance()) }

    LaunchedEffect(liveSeconds) {
        while (liveSeconds) {
            currentTime = Calendar.getInstance()
            delay(1000L)
        }
    }

    val hour = currentTime.get(Calendar.HOUR)
    val minute = currentTime.get(Calendar.MINUTE)
    val second = if (liveSeconds) currentTime.get(Calendar.SECOND) else 35

    val dateFormatted = remember {
        SimpleDateFormat("EEE, d MMM", Locale.ENGLISH).format(Date()).uppercase()
    }

    Box(
        modifier = Modifier
            .size(280.dp)
            .shadow(24.dp, CircleShape, spotColor = theme.primary.copy(alpha = 0.5f))
            .clip(CircleShape)
            .background(Color.Black)
            .border(9.dp, Color(0xFF1E2127), CircleShape)
            .border(10.dp, Color(0xFF121418), CircleShape)
            .padding(10.dp),
        contentAlignment = Alignment.Center
    ) {
        // خلفية المينا ونسيجها
        Canvas(modifier = Modifier.fillMaxSize()) {
            val center = Offset(size.width / 2, size.height / 2)
            val radius = size.width / 2

            when (dialBackground) {
                DialBackground.DEEP_OLED -> {
                    drawCircle(color = Color(0xFF07080A), radius = radius, center = center)
                    drawCircle(
                        color = Color(0xFF1B1E26),
                        radius = radius * 0.95f,
                        center = center,
                        style = Stroke(1.5f)
                    )
                    drawCircle(
                        color = Color(0xFF12141A),
                        radius = radius * 0.72f,
                        center = center,
                        style = Stroke(1.0f)
                    )
                }
                DialBackground.RADIAL_MATERIAL -> {
                    drawCircle(
                        brush = Brush.radialGradient(
                            colors = listOf(
                                theme.container.copy(alpha = 0.85f),
                                Color(0xFF0A0C10)
                            ),
                            center = center,
                            radius = radius
                        ),
                        radius = radius,
                        center = center
                    )
                }
                DialBackground.CARBON_TEXTURE -> {
                    drawCircle(color = Color(0xFF0F1116), radius = radius, center = center)
                    val step = 12.dp.toPx()
                    var x = 0f
                    while (x < size.width) {
                        drawLine(
                            color = Color(0xFF1B1F27),
                            start = Offset(x, 0f),
                            end = Offset(x, size.height),
                            strokeWidth = 1f
                        )
                        x += step
                    }
                    var y = 0f
                    while (y < size.height) {
                        drawLine(
                            color = Color(0xFF1B1F27),
                            start = Offset(0f, y),
                            end = Offset(size.width, y),
                            strokeWidth = 1f
                        )
                        y += step
                    }
                }
                DialBackground.CHRONO_RINGS -> {
                    drawCircle(color = Color(0xFF0A0B0E), radius = radius, center = center)
                    drawCircle(
                        color = Color(0xFF151820),
                        radius = radius * 0.28f,
                        center = Offset(center.x - radius * 0.42f, center.y),
                        style = Stroke(1.5f)
                    )
                    drawCircle(
                        color = Color(0xFF151820),
                        radius = radius * 0.28f,
                        center = Offset(center.x + radius * 0.42f, center.y),
                        style = Stroke(1.5f)
                    )
                }
            }

            drawDialIndices(indexStyle, theme.primary, center, radius)
        }

        // عناصر وإضافات Material You
        Box(modifier = Modifier.fillMaxSize()) {
            if (showDate) {
                Box(
                    modifier = Modifier
                        .align(Alignment.TopCenter)
                        .padding(top = 22.dp)
                        .clip(RoundedCornerShape(12.dp))
                        .background(theme.container.copy(alpha = 0.9f))
                        .border(1.dp, theme.primary.copy(alpha = 0.4f), RoundedCornerShape(12.dp))
                        .padding(horizontal = 10.dp, vertical = 3.dp)
                ) {
                    Text(
                        text = dateFormatted,
                        fontSize = 11.sp,
                        fontWeight = FontWeight.Bold,
                        color = theme.onContainer,
                        letterSpacing = 0.8.sp
                    )
                }
            }

            if (showWeather) {
                Box(
                    modifier = Modifier
                        .align(Alignment.CenterStart)
                        .padding(start = 16.dp)
                        .clip(RoundedCornerShape(10.dp))
                        .background(Color(0xFF1A1D24).copy(alpha = 0.85f))
                        .padding(horizontal = 6.dp, vertical = 4.dp)
                ) {
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        Text("☀️", fontSize = 11.sp)
                        Spacer(modifier = Modifier.width(3.dp))
                        Text(
                            "24°",
                            fontSize = 12.sp,
                            fontWeight = FontWeight.Bold,
                            color = Color.White
                        )
                    }
                }
            }

            if (showSteps) {
                Box(
                    modifier = Modifier
                        .align(Alignment.CenterEnd)
                        .padding(end = 16.dp)
                        .clip(RoundedCornerShape(10.dp))
                        .background(Color(0xFF1A1D24).copy(alpha = 0.85f))
                        .padding(horizontal = 6.dp, vertical = 4.dp)
                ) {
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        Text("👣", fontSize = 10.sp)
                        Spacer(modifier = Modifier.width(3.dp))
                        Text(
                            "8.4k",
                            fontSize = 12.sp,
                            fontWeight = FontWeight.Bold,
                            color = theme.primary
                        )
                    }
                }
            }

            if (showBattery) {
                Box(
                    modifier = Modifier
                        .align(Alignment.BottomCenter)
                        .padding(bottom = 22.dp)
                        .clip(RoundedCornerShape(12.dp))
                        .background(Color(0xFF161920))
                        .border(1.dp, Color(0xFF2E3340), RoundedCornerShape(12.dp))
                        .padding(horizontal = 10.dp, vertical = 3.dp)
                ) {
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        Box(
                            modifier = Modifier
                                .size(7.dp)
                                .clip(CircleShape)
                                .background(theme.primary)
                        )
                        Spacer(modifier = Modifier.width(5.dp))
                        Text(
                            "88%",
                            fontSize = 11.sp,
                            fontWeight = FontWeight.Bold,
                            color = Color.White
                        )
                    }
                }
            }
        }

        // رسم العقارب التناظرية الفخمة بنظام Canvas
        Canvas(modifier = Modifier.fillMaxSize()) {
            val center = Offset(size.width / 2, size.height / 2)
            val radius = size.width / 2

            val hourAngle = ((hour % 12) + minute / 60f) * 30.0 * (Math.PI / 180.0) - Math.PI / 2.0
            val minAngle = (minute + second / 60f) * 6.0 * (Math.PI / 180.0) - Math.PI / 2.0
            val secAngle = second * 6.0 * (Math.PI / 180.0) - Math.PI / 2.0

            drawWatchHands(
                style = handsStyle,
                center = center,
                radius = radius,
                hourAngle = hourAngle,
                minAngle = minAngle,
                secAngle = secAngle,
                accentColor = theme.primary
            )
        }
    }
}

