            Spacer(modifier = Modifier.height(16.dp))

            // إضافات Material You
            SectionContainer(title = "عناصر وإضافات Material You", icon = Icons.Default.ThumbUp) {
                ComplicationRow(
                    title = "التاريخ واليوم (Date Pill)",
