            }

            Spacer(modifier = Modifier.height(28.dp))

            // لوحة ألوان Material You
            SectionContainer(title = "ألوان نظام Material You", icon = Icons.Default.Star) {
                LazyRow(
                    horizontalArrangement = Arrangement.spacedBy(12.dp),
                    modifier = Modifier.fillMaxWidth()
                ) {
                    items(MaterialYouPalette) { themeItem ->
                        val isSelected = selectedThemeColor == themeItem
                        Column(
                            horizontalAlignment = Alignment.CenterHorizontally,
                            modifier = Modifier
                                .clip(RoundedCornerShape(16.dp))
                                .clickable { selectedThemeColor = themeItem }
                                .background(
                                    if (isSelected) themeItem.primary.copy(alpha = 0.15f)
                                    else Color.Transparent
                                )
                                .padding(8.dp)
                        ) {
                            Box(
                                modifier = Modifier
                                    .size(46.dp)
                                    .clip(CircleShape)
                                    .background(themeItem.primary)
                                    .border(
                                        width = if (isSelected) 3.dp else 1.dp,
                                        color = if (isSelected) Color.White else Color.Transparent,
                                        shape = CircleShape
