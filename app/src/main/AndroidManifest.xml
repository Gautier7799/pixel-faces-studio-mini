                Divider(modifier = Modifier.padding(vertical = 8.dp), color = MaterialTheme.colorScheme.surface)

                ComplicationRow(
                    title = "عداد الخطوات اليومي",
                    subtitle = "عرض الخطوات مع أيقونة ملونة 8,432",
                    checked = showSteps,
                    icon = Icons.Default.LocationOn,
                    theme = selectedThemeColor
