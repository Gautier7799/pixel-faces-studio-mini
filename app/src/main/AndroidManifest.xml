                actions = {
                    IconButton(onClick = { liveSecondsTick = !liveSecondsTick }) {
                        Icon(
                            imageVector = if (liveSecondsTick) Icons.Default.PlayArrow else Icons.Default.Close,
                            contentDescription = "ثواني حية",
                            tint = if (liveSecondsTick) selectedThemeColor.primary else Color.Gray
                        )
                    }
                }
