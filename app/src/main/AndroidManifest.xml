        }
    ) { padding ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(padding)
                .verticalScroll(rememberScrollState()),
            horizontalAlignment = Alignment.CenterHorizontally
        ) {
            Spacer(modifier = Modifier.height(18.dp))

            // معاينة شاشة الساعة الفخمة
            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(horizontal = 16.dp),
                contentAlignment = Alignment.Center
            ) {
                AnalogWatchPreview(
                    handsStyle = selectedHandsStyle,
                    dialBackground = selectedBackground,
                    indexStyle = selectedIndexStyle,
                    theme = selectedThemeColor,
                    showDate = showDate,
                    showBattery = showBattery,
                    showWeather = showWeather,
                    showHeartRate = showHeartRate,
                    showSteps = showSteps,
                    liveSeconds = liveSecondsTick
