fun DrawScope.drawDialIndices(
    indexStyle: DialIndexStyle,
    accentColor: Color,
    center: Offset,
    radius: Float
) {
    when (indexStyle) {
        DialIndexStyle.CLASSIC_TICKS -> {
            for (i in 0 until 60) {
                val angle = i * 6.0 * (Math.PI / 180.0)
                val isHour = i % 5 == 0
                val tickLength = if (isHour) 12.dp.toPx() else 5.dp.toPx()
                val tickWidth = if (isHour) 3.5.dp.toPx() else 1.2.dp.toPx()
                val tickColor = if (isHour) {
                    if (i % 15 == 0) accentColor else Color.White.copy(alpha = 0.85f)
                } else {
                    Color.Gray.copy(alpha = 0.35f)
                }

                val startR = radius - tickLength - 3.dp.toPx()
                val endR = radius - 3.dp.toPx()

                drawLine(
                    color = tickColor,
                    start = Offset(
                        center.x + startR * cos(angle).toFloat(),
                        center.y + startR * sin(angle).toFloat()
                    ),
                    end = Offset(
                        center.x + endR * cos(angle).toFloat(),
                        center.y + endR * sin(angle).toFloat()
                    ),
                    strokeWidth = tickWidth,
                    cap = StrokeCap.Round
                )
            }
        }
        DialIndexStyle.MODERN_NUMBERS, DialIndexStyle.DOTS_MINIMAL -> {
            for (i in 0 until 12) {
                val angle = i * 30.0 * (Math.PI / 180.0)
                val isCardinal = i % 3 == 0
                val dotRadius = if (isCardinal) 4.5.dp.toPx() else 2.2.dp.toPx()
                val dotColor = if (isCardinal) accentColor else Color.White.copy(alpha = 0.6f)
                val r = radius - 14.dp.toPx()

                drawCircle(
                    color = dotColor,
                    radius = dotRadius,
                    center = Offset(
                        center.x + r * cos(angle).toFloat(),
                        center.y + r * sin(angle).toFloat()
                    )
                )
            }
        }
        DialIndexStyle.CLEAN_EMPTY -> {
            for (i in 0 until 4) {
                val angle = i * 90.0 * (Math.PI / 180.0)
                val r = radius - 12.dp.toPx()
                drawCircle(
                    color = accentColor.copy(alpha = 0.6f),
                    radius = 3.dp.toPx(),
                    center = Offset(
                        center.x + r * cos(angle).toFloat(),
                        center.y + r * sin(angle).toFloat()
                    )
                )
            }
        }
    }
}

fun DrawScope.drawWatchHands(
    style: HandsStyle,
    center: Offset,
    radius: Float,
    hourAngle: Double,
    minAngle: Double,
    secAngle: Double,
    accentColor: Color
) {
    val hourLength = radius * 0.52f
    val minLength = radius * 0.78f
    val secLength = radius * 0.88f

    when (style) {
        HandsStyle.PIXEL_BATON -> {
            drawLine(
                color = Color.White,
                start = center,
                end = Offset(
                    center.x + hourLength * cos(hourAngle).toFloat(),
                    center.y + hourLength * sin(hourAngle).toFloat()
                ),
                strokeWidth = 7.dp.toPx(),
                cap = StrokeCap.Round
            )
            drawLine(
                color = Color.White,
                start = center,
                end = Offset(
                    center.x + minLength * cos(minAngle).toFloat(),
                    center.y + minLength * sin(minAngle).toFloat()
                ),
                strokeWidth = 5.dp.toPx(),
                cap = StrokeCap.Round
            )
            val counterR = radius * 0.20f
            drawLine(
                color = accentColor,
                start = Offset(
                    center.x - counterR * cos(secAngle).toFloat(),
                    center.y - counterR * sin(secAngle).toFloat()
                ),
                end = Offset(
                    center.x + secLength * cos(secAngle).toFloat(),
                    center.y + secLength * sin(secAngle).toFloat()
                ),
                strokeWidth = 2.dp.toPx(),
                cap = StrokeCap.Round
            )
            drawCircle(
                color = accentColor,
                radius = 4.dp.toPx(),
                center = Offset(
                    center.x + (secLength * 0.75f) * cos(secAngle).toFloat(),
                    center.y + (secLength * 0.75f) * sin(secAngle).toFloat()
                )
            )
        }

        HandsStyle.PILOT_CHRONO -> {
            val hourEnd = Offset(
                center.x + hourLength * cos(hourAngle).toFloat(),
                center.y + hourLength * sin(hourAngle).toFloat()
            )
            drawLine(
                color = Color.White,
                start = center,
                end = hourEnd,
                strokeWidth = 8.dp.toPx(),
                cap = StrokeCap.Square
            )
            drawLine(
                color = Color.Black,
                start = center,
                end = hourEnd,
                strokeWidth = 2.dp.toPx(),
                cap = StrokeCap.Square
            )

            val minEnd = Offset(
                center.x + minLength * cos(minAngle).toFloat(),
                center.y + minLength * sin(minAngle).toFloat()
            )
            drawLine(
                color = Color.White,
                start = center,
                end = minEnd,
                strokeWidth = 6.dp.toPx(),
                cap = StrokeCap.Square
            )
            drawLine(
                color = Color.Black,
                start = center,
                end = minEnd,
                strokeWidth = 2.dp.toPx(),
                cap = StrokeCap.Square
            )

            drawLine(
                color = accentColor,
                start = center,
                end = Offset(
                    center.x + secLength * cos(secAngle).toFloat(),
                    center.y + secLength * sin(secAngle).toFloat()
                ),
                strokeWidth = 2.2.dp.toPx(),
                cap = StrokeCap.Round
            )
        }

        HandsStyle.SKELETON_SPORT -> {
            drawLine(
                color = Color.White,
                start = center,
                end = Offset(
                    center.x + hourLength * cos(hourAngle).toFloat(),
                    center.y + hourLength * sin(hourAngle).toFloat()
                ),
                strokeWidth = 9.dp.toPx(),
                cap = StrokeCap.Round
            )
            val innerHourLen = hourLength * 0.65f
            drawLine(
                color = Color.Black,
                start = Offset(
                    center.x + (hourLength * 0.2f) * cos(hourAngle).toFloat(),
                    center.y + (hourLength * 0.2f) * sin(hourAngle).toFloat()
                ),
                end = Offset(
                    center.x + innerHourLen * cos(hourAngle).toFloat(),
                    center.y + innerHourLen * sin(hourAngle).toFloat()
                ),
                strokeWidth = 3.5.dp.toPx(),
                cap = StrokeCap.Round
            )

            drawLine(
                color = Color.White,
                start = center,
                end = Offset(
                    center.x + minLength * cos(minAngle).toFloat(),
                    center.y + minLength * sin(minAngle).toFloat()
                ),
                strokeWidth = 7.dp.toPx(),
                cap = StrokeCap.Round
            )
            val innerMinLen = minLength * 0.70f
            drawLine(
                color = Color.Black,
                start = Offset(
                    center.x + (minLength * 0.2f) * cos(minAngle).toFloat(),
                    center.y + (minLength * 0.2f) * sin(minAngle).toFloat()
                ),
                end = Offset(
                    center.x + innerMinLen * cos(minAngle).toFloat(),
                    center.y + innerMinLen * sin(minAngle).toFloat()
                ),
                strokeWidth = 2.8.dp.toPx(),
                cap = StrokeCap.Round
            )

            drawLine(
                color = accentColor,
                start = center,
                end = Offset(
                    center.x + secLength * cos(secAngle).toFloat(),
                    center.y + secLength * sin(secAngle).toFloat()
                ),
                strokeWidth = 2.dp.toPx(),
                cap = StrokeCap.Round
            )
        }

        HandsStyle.MINIMAL_NEEDLE -> {
            drawLine(
                color = Color.White.copy(alpha = 0.95f),
                start = center,
                end = Offset(
                    center.x + hourLength * cos(hourAngle).toFloat(),
                    center.y + hourLength * sin(hourAngle).toFloat()
                ),
                strokeWidth = 3.5.dp.toPx(),
                cap = StrokeCap.Round
            )
            drawLine(
                color = Color.White.copy(alpha = 0.95f),
                start = center,
                end = Offset(
                    center.x + minLength * cos(minAngle).toFloat(),
                    center.y + minLength * sin(minAngle).toFloat()
                ),
                strokeWidth = 2.5.dp.toPx(),
                cap = StrokeCap.Round
            )
            drawLine(
                color = accentColor,
                start = center,
                end = Offset(
                    center.x + secLength * cos(secAngle).toFloat(),
                    center.y + secLength * sin(secAngle).toFloat()
                ),
                strokeWidth = 1.5.dp.toPx(),
                cap = StrokeCap.Round
            )
        }
    }

    drawCircle(color = Color.White, radius = 5.dp.toPx(), center = center)
    drawCircle(color = accentColor, radius = 2.8.dp.toPx(), center = center)
}

